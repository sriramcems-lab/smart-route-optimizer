# ==============================================================================
# SMART ROUTE OPTIMIZER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your actual keys.
# NEVER commit your actual .env file or expose server API keys to the frontend.
# ==============================================================================

# 1. Google Maps Browser API Key (Used in frontend for Maps JS API & Places Autocomplete)
# Recommended restriction in GCP: HTTP referrers (e.g., http://localhost:5000/*)
GOOGLE_MAPS_BROWSER_API_KEY=your_google_maps_browser_api_key_here

# 2. Google Routes Server API Key (Used strictly on Flask backend for Compute Route Matrix & Compute Routes)
# Recommended restriction in GCP: IP address restriction or API restriction to Routes API
# NOTE: If this key is left empty or invalid, the app runs in DEMO MODE (simulated physics-based costs)
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key_here

# 3. Flask Secret Key (Used for session signing and security)
# Generate using: python -c import secrets; print(secrets.token_hex(32))
FLASK_SECRET_KEY=replace_with_a_secure_random_secret_key

# 4. Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
